#!/usr/bin/env python3
"""buny-icon-attribution — write assets/distro-icons/ATTRIBUTION.md.

Lists every distribution mark shipped in assets/distro-icons/simple-icons/
with the licence, source and brand guidelines recorded by Simple Icons
(icons.json).  Simple Icons as a project is CC0, but some marks carry their
own licence (CC-BY, CC-BY-SA, GPL, MIT or a vendor's brand terms), and
those require attribution when the icons are redistributed in an image.
Run it again after adding or updating icons.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
ICONS = ROOT / "assets" / "distro-icons" / "simple-icons"
OUT = ROOT / "assets" / "distro-icons" / "ATTRIBUTION.md"


def main() -> int:
    meta = json.loads((ICONS / "icons.json").read_text())
    rows = []
    for svg in sorted(ICONS.glob("*.svg")):
        m = meta.get(svg.stem)
        if not m:
            print(f"buny-icon-attribution: no metadata for {svg.name}", file=sys.stderr)
            return 1
        lic = m.get("license")
        if not lic:
            licence = "CC0-1.0 (Simple Icons)"
        elif lic.get("type") == "custom":
            licence = f"vendor terms: {lic.get('url', '')}"
        else:
            licence = lic["type"] + (f" ({lic['url']})" if lic.get("url") else "")
        rows.append(f"| {m['title']} | `{svg.name}` | {licence} | {m.get('source', '')} | {m.get('guidelines') or '—'} |")
    OUT.write_text(
        "# Distribution marks — attribution\n\n"
        "Generated by `tools/development/buny-icon-attribution` from Simple Icons' `icons.json`.\n\n"
        "The marks are trademarks of their owners. Distro Buny shows them only to identify the\n"
        "corresponding ISO images, in each brand's colour and without modification of the artwork,\n"
        "following the owners' guidelines where they publish any. Simple Icons as a collection is\n"
        "released under CC0-1.0; the marks below that name another licence are used under that\n"
        "licence, and this file is their attribution notice.\n\n"
        "| Mark | File | Licence | Source | Brand guidelines |\n| --- | --- | --- | --- | --- |\n"
        + "\n".join(rows) + "\n")
    print(f"wrote {OUT} ({len(rows)} marks)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
