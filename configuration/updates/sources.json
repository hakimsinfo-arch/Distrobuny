    {
      "id": "debian-netinst", "name": "Debian (netinst)",
      "installed": "^debian-(?P<version>\\d+\\.\\d+\\.\\d+)-amd64-netinst\\.iso$",
      "checksums": "https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/SHA512SUMS",
      "pick": "^debian-(?P<version>\\d+\\.\\d+\\.\\d+)-amd64-netinst\\.iso$",
      "signature": {"type": "detached", "url": "{checksums}.sign", "key": "debian-cd.asc"},
      "download": "https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/{file}"
    },
    {
      "id": "archlinux", "name": "Arch Linux",
      "installed": "^archlinux-(?:(?P<version>\\d{4}\\.\\d{2}\\.\\d{2})-)?x86_64\\.iso$",
      "installed_version_from": "metadata",
      "checksums": "https://archlinux.org/iso/latest/sha256sums.txt",
      "pick": "^archlinux-(?P<version>\\d{4}\\.\\d{2}\\.\\d{2})-x86_64\\.iso$",
      "signature": {"type": "image-detached", "url": "https://archlinux.org/iso/latest/{file}.sig", "key": "archlinux-releng.asc"},
      "download": "https://geo.mirror.pkgbuild.com/iso/latest/{file}",
      "note": "Arch signs the image itself; the checksum list is fetched over HTTPS and the image signature is verified after download."
    },
    {
      "id": "linuxmint", "name": "Linux Mint",
      "installed": "^linuxmint-(?P<version>\\d+\\.\\d+)-(?P<edition>[a-z]+)-64bit\\.iso$",
      "series": {"index": "https://mirrors.edge.kernel.org/linuxmint/stable/", "regex": "href=\"(\\d+\\.\\d+)/\"", "policy": "latest"},
      "checksums": "https://mirrors.edge.kernel.org/linuxmint/stable/{series}/sha256sum.txt",
      "pick": "^\\*?linuxmint-(?P<version>\\d+\\.\\d+)-{edition}-64bit\\.iso$",
      "signature": {"type": "detached", "url": "{checksums}.gpg", "key": "linuxmint.asc"},
      "download": "https://mirrors.edge.kernel.org/linuxmint/stable/{series}/{file}"
    },
    {
