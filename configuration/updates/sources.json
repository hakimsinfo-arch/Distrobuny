{
  "comment": [
    "Trusted update sources for buny-update.  Every source names the vendor's official checksum list and the OpenPGP key",
    "that signs it (or that signs the image itself).  Fingerprints are pinned: a signature from any other key is rejected.",
    "Pinned fingerprints were cross-checked against the vendors' own documentation; see documentation/SECURITY.md.",
    "Placeholders: {series} (discovered release series), {file} (image file name), {flavor}.",
    "series.policy: 'track' keeps an LTS installation on LTS releases and an interim one on the newest release."
  ],
  "keys": {
    "ubuntu-cdimage.asc": ["843938DF228D22F7B3742BC0D94AA3F0EFE21092"],
    "debian-cd.asc": ["DF9B9C49EAA9298432589D76DA87E80D6294BE9B"],
    "archlinux-releng.asc": ["3E80CA1A8B89F69CBA57D98A76A5EF9054449A5C"],
    "linuxmint.asc": ["27DEB15644C6B3CF3BD7D291300F846BA25BAE09"],
    "fedora.asc": ["36F612DCF27F7D1A48A835E4DBFCF71C6D9F90A6", "C6E7F081CF80E13146676E88829B606631645531",
                   "4F50A6114CD5C6976A7F1179655A4B02F577861E", "D924B10D3E810DABDD8B56B596E7E91491211FCE"],
    "opensuse.asc": ["AD485664E901B867051AB15F35A2F86E29B700A4"]
  },
  "templates": {
    "ubuntu-flavor": {
      "series": {"index": "https://cdimage.ubuntu.com/{flavor}/releases/", "regex": "href=\"(\\d{2}\\.\\d{2})/\"", "policy": "track"},
      "checksums": "https://cdimage.ubuntu.com/{flavor}/releases/{series}/release/SHA256SUMS",
      "signature": {"type": "detached", "url": "{checksums}.gpg", "key": "ubuntu-cdimage.asc"},
      "download": "https://cdimage.ubuntu.com/{flavor}/releases/{series}/release/{file}"
    }
  },
  "sources": [
    {
      "id": "ubuntu-desktop", "name": "Ubuntu Desktop",
      "installed": "^ubuntu-(?P<version>\\d{2}\\.\\d{2}(?:\\.\\d+)?)-desktop-amd64\\.iso$",
      "series": {"index": "https://releases.ubuntu.com/", "regex": "href=\"(\\d{2}\\.\\d{2})/\"", "policy": "track"},
      "checksums": "https://releases.ubuntu.com/{series}/SHA256SUMS",
      "pick": "^ubuntu-(?P<version>\\d{2}\\.\\d{2}(?:\\.\\d+)?)-desktop-amd64\\.iso$",
      "signature": {"type": "detached", "url": "{checksums}.gpg", "key": "ubuntu-cdimage.asc"},
      "download": "https://releases.ubuntu.com/{series}/{file}"
    },
    {
      "id": "ubuntu-server", "name": "Ubuntu Server",
      "installed": "^ubuntu-(?P<version>\\d{2}\\.\\d{2}(?:\\.\\d+)?)-live-server-amd64\\.iso$",
      "series": {"index": "https://releases.ubuntu.com/", "regex": "href=\"(\\d{2}\\.\\d{2})/\"", "policy": "track"},
      "checksums": "https://releases.ubuntu.com/{series}/SHA256SUMS",
      "pick": "^ubuntu-(?P<version>\\d{2}\\.\\d{2}(?:\\.\\d+)?)-live-server-amd64\\.iso$",
      "signature": {"type": "detached", "url": "{checksums}.gpg", "key": "ubuntu-cdimage.asc"},
      "download": "https://releases.ubuntu.com/{series}/{file}"
    },
    {"id": "kubuntu", "name": "Kubuntu", "template": "ubuntu-flavor", "flavor": "kubuntu",
